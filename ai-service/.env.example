# ============================================================
# AI Service — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Database (same as backend)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/peerreview

# Inter-service auth (must match AI_API_KEY in backend .env)
AI_API_KEY=

# Server
AI_PORT=5001
FLASK_DEBUG=0
# Development: http://localhost:5173
# Production:  https://www.peer.review.uconn.edu
FRONTEND_URL=http://localhost:5173
