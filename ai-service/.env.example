# ============================================================
# AI Service — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Required for AI features ────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Database (same PostgreSQL as backend) ───────────────────
# Used for AI activity logs and search.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/peerreview

# ── Inter-service auth ──────────────────────────────────────
# Must match AI_API_KEY in backend .env (backend sends this when proxying to AI)
AI_API_KEY=

# ── Server ──────────────────────────────────────────────────
AI_PORT=5001
FLASK_DEBUG=0

# ── CORS ────────────────────────────────────────────────────
# Allowed origin for browser requests (development vs production)
# Development: http://localhost:5173
# Production:  https://www.peer.review.uconn.edu
FRONTEND_URL=http://localhost:5173

# ── Similarity Detection (v3.0) ─────────────────────────
# Uses scikit-learn TF-IDF vectorizer + cosine similarity
# No additional config needed — uses built-in defaults

# ── AI Conversation ─────────────────────────────────────
# Multi-turn chat stored in ai_conversations table
# Requires valid user_id (UUID FK) for persistence
