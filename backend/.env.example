# ============================================================
# PeerReview Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NEVER commit .env to version control (it is in .gitignore).
# ============================================================

# ── Required ────────────────────────────────────────────────
# Database connection string (required for server start)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/peerreview

# JWT signing secret (REQUIRED in production)
# Minimum 64 characters (256 bits). Production rejects shorter keys.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRES_IN=30d

# ── Server ──────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
# Set to "production" in deployed environments
NODE_ENV=development
# Set to "true" to skip running migrations on server start (e.g. when using external migrate job)
# SKIP_MIGRATE=false

# ── Reverse Proxy ──────────────────────────────────────────
# Set to 1 when behind nginx/load balancer for correct IP in rate limiting and logging
# TRUST_PROXY=1

# ── CORS & Frontend ─────────────────────────────────────────
# Single origin or comma-separated list; defaults to FRONTEND_URL if not set
# CORS_ORIGINS=http://localhost:5173,https://www.peer.review.uconn.edu
# Frontend URL for CORS and CAS redirect (used when CORS_ORIGINS not set)
FRONTEND_URL=http://localhost:5173

# ── CAS SSO (production) ───────────────────────────────────
# CAS_BASE_URL=https://login.uconn.edu/cas

# ── Default enrollment (optional, for dev/seed) ──────────────
# DEFAULT_COURSE_ID=CSE4939W
# DEFAULT_GROUP_ID=G1

# ── Database pool (optional) ──────────────────────────────────
# PG_POOL_MAX=20
# PG_IDLE_TIMEOUT_MS=30000
# PG_CONN_TIMEOUT_MS=5000

# ── Logging ─────────────────────────────────────────────────
# LOG_LEVEL=debug   (use info or warn in production to avoid verbose logs)

# ── File uploads ───────────────────────────────────────────
UPLOAD_DIR=./uploads
# Max single file size in bytes (default 10 MB)
MAX_FILE_SIZE=10485760

# ── CSV upload (instructor) ─────────────────────────────────
# MAX_CSV_FILE_SIZE=2097152
# MAX_CSV_FILES=30

# ── AI Service ──────────────────────────────────────────────
# URL of the AI micro-service (Flask). Use http://ai-service:5001 inside Docker.
AI_SERVICE_URL=http://localhost:5001
# Shared secret for inter-service auth (must match AI_API_KEY in ai-service)
# REQUIRED: AI service rejects all requests when this is empty
AI_API_KEY=

# ── Notification email (optional) ───────────────────────────
# Set true to enable email channel for notification types whose preference email=true
EMAIL_NOTIFICATIONS_ENABLED=false
# SMTP settings
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-user
# SMTP_PASS=your-pass
# SMTP_FROM=no-reply@example.com

# ── Browser push (optional) ─────────────────────────────────
# VAPID public key used by frontend PushManager subscription.
# Keep private key out of frontend.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:no-reply@example.com

# ── Materialized view refresh (optional) ───────────────────
# MV_DEBOUNCE_MS=5000
# MV_PERIODIC_MS=600000

# ── Rate Limiting (built-in, no configuration needed) ──────
# Global: 100 req/min per IP
# Auth endpoints: 20 req/5 min per IP
# Upload: 100 req/10 min per IP
# Write operations (instructor, peer-review, enrollments): 30 req/10 min per IP
# AI endpoints: Flask-Limiter (30/min feedback/polish, 20/min rewrite/summarize)

# ── Security Features (built-in) ──────────────────────────
# Content-Security-Policy: strict CSP via Helmet (script/img/style/connect/font-src)
# Security headers: X-Content-Type-Options, X-Frame-Options, HSTS, Referrer-Policy (nginx)
# JWT verification: HS256 algorithm lock, 64-char minimum secret in production
# File downloads: ownership verification (submitter, reviewer, or instructor)

# ── Production Security Checklist ─────────────────────────
# [ ] JWT_SECRET is >= 64 random characters (not the default)
# [ ] AI_API_KEY is set and matches ai-service/.env
# [ ] CORS_ORIGINS / FRONTEND_URL set to production domain (no localhost)
# [ ] NODE_ENV=production
# [ ] TRUST_PROXY=1 (if behind reverse proxy)
# [ ] DATABASE_URL uses strong credentials (not postgres:postgres)
# [ ] OPENAI_API_KEY is set (in ai-service .env)
# [ ] All .env files excluded from version control
