# ============================================================
# PeerReview Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NEVER commit .env to version control (it is in .gitignore).
# ============================================================

# Server
PORT=8080
# Set to "production" in deployed environments
NODE_ENV=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/peerreview

# JWT
# ⚠️  IMPORTANT: Generate a strong random secret for production!
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The server will refuse to start in production if this is left as default.
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRES_IN=30d

# CAS (UConn SSO) — only needed in production
# BACKEND_URL=https://www.peer.review.uconn.edu

# Frontend URL (for CORS + CAS redirect)
# Development: http://localhost:5173
# Production:  https://www.peer.review.uconn.edu
FRONTEND_URL=http://localhost:5173

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# AI Service
# URL of the AI micro-service (Flask). Use http://ai-service:5001 inside Docker.
AI_SERVICE_URL=http://localhost:5001
# Shared secret for inter-service authentication (must match AI_API_KEY in ai-service)
AI_API_KEY=
