# ============================================================
# Root — used by docker-compose and start-dev.ps1
# ============================================================
# Copy to .env at repo root. For backend/ai-service specific vars,
# see backend/.env.example and ai-service/.env.example.
# ============================================================

# Required when running full stack with docker compose (backend needs JWT_SECRET)
# Minimum 64 characters. Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Optional overrides (docker-compose passes these to backend/ai-service)
# JWT_EXPIRES_IN=30d
# FRONTEND_URL=https://www.peer.review.uconn.edu
# CORS_ORIGINS=https://www.peer.review.uconn.edu,http://localhost:5173
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AI_API_KEY=

# ── Production Deployment ────────────────────────────────────
# Set these variables in your hosting platform's secrets manager:
#   JWT_SECRET    — at least 64 random hex chars
#   OPENAI_API_KEY — OpenAI API key for AI features
#   AI_API_KEY    — shared secret between backend and ai-service
#   DATABASE_URL  — PostgreSQL connection (strong credentials)
# Never commit real secrets to .env files in version control.
