# ── Copy this file to .env and fill in values ──────
# cp .env.example .env

# ── Database ────────────────────────────────────────
POSTGRES_PASSWORD=postgres

# ── Backend ─────────────────────────────────────────
# Use a long random string in production:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

JWT_EXPIRES_IN=30d

# Max file upload size in bytes (default 10 MB)
MAX_FILE_SIZE=10485760

# ── CAS Single Sign-On ───────────────────────────────
# The public URL this stack is reachable at.
# For local dev: http://localhost
# For production: https://your-domain.com
APP_URL=http://localhost

CAS_BASE_URL=https://login.uconn.edu/cas

# ── App port ─────────────────────────────────────────
# Change to e.g. 3000 if port 80 is taken
APP_PORT=80
